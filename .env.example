# Server-only values. Never use VITE_ prefixes for credentials.
# Match the exact browser origin (including the port, no trailing slash).
DEVORBIT_ORIGIN=http://localhost:5173
# OAuth callback: http://localhost:5173/api/github/oauth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Public repositories by default. For private repositories, use: read:user repo
GITHUB_OAUTH_SCOPE=read:user public_repo
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Required in production; development generates an ephemeral secret when omitted.
SESSION_SECRET=
# Production reverse proxy only: set to 1 when exactly one trusted proxy is in front.
DEVORBIT_TRUST_PROXY=0
# npm start defaults. Build first. Production requires HTTPS and a session secret.
HOST=127.0.0.1
PORT=3000
